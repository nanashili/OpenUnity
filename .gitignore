# Product publication: everything is private unless explicitly allowed below.
/*
!/.gitignore
!/Cargo.toml
!/Cargo.lock
!/global.json
!/rust-toolchain.toml

# Publish only this explicitly reviewed CI workflow.
!/.github/
/.github/**
!/.github/workflows/
!/.github/workflows/build.yml

# Native engine and player sources, manifests, and required format schema.
!/crates/
/crates/**
!/crates/**/
!/crates/**/Cargo.toml
!/crates/**/src/**/*.rs
!/crates/**/tests/**/*.rs
!/crates/engine-scene/src/settings-defaults.json

# Application entrypoints and editor-owned services; local assets stay private.
!/apps/
/apps/**
!/apps/**/
!/apps/**/Cargo.toml
!/apps/**/src/**/*.rs
!/apps/cli/tests/wav_cli_export.rs

# Independent managed compatibility and hosting sources.
!/managed/
/managed/**
!/managed/**/
!/managed/**/*.cs
!/managed/**/*.csproj

# Authored-project compiler, without research and inventory tooling.
!/build-tools/
/build-tools/**
!/build-tools/run_project.py

# Defense in depth: never publish research, documentation, results or caches.
/docs/
/conformance/
/research-raw/
/research/
/performance/
/benchmarks/
/target/
/dist/
/build/
/apps/editor/assets/
**/bin/
**/obj/
**/__pycache__/
**/.cache/
**/.venv/
**/node_modules/
**/.DS_Store
**/.env
**/.env.*
**/credentials*
**/*secret*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.log
**/*.profraw
**/*.profdata
**/*.trace
**/*.gpr
**/*.rep/
**/*.dll
**/*.dylib
**/*.so
**/*.exe
**/*.ttf
**/*.otf
**/*.png
**/*.jpg
**/*.jpeg
**/*.pdf
**/*.md

# Explicitly requested public project overview; all other Markdown stays private.
!/README.md
