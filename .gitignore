# Code-only publication: everything is private unless explicitly allowed below.
/*
!/.gitignore
!/Cargo.toml
!/Cargo.lock
!/global.json

# Publish only this explicitly reviewed CI workflow.
!/.github/
/.github/**
!/.github/workflows/
!/.github/workflows/build.yml

# Native engine and player sources, manifests, and required format schema.
!/crates/
/crates/**
!/crates/**/
!/crates/**/Cargo.toml
!/crates/**/src/**/*.rs
!/crates/scene/src/settings-defaults.json
!/player/
/player/**
!/player/Cargo.toml
!/player/src/
!/player/src/**/*.rs

# Independent managed compatibility and hosting sources.
!/managed/
/managed/**
!/managed/**/
!/managed/**/*.cs
!/managed/**/*.csproj

# Editor sources only; extracted reference resources remain local.
!/editor/
/editor/**
!/editor/Cargo.toml
!/editor/src/
!/editor/src/**/
!/editor/src/**/*.rs

# Authored-project compiler, without research and inventory tooling.
!/build-tools/
/build-tools/**
!/build-tools/run_project.py

# Defense in depth: never publish research, documentation, results or caches.
/docs/
/conformance/
/research-raw/
/research/
/performance/
/benchmarks/
/target/
/dist/
/build/
/editor/assets/
**/bin/
**/obj/
**/__pycache__/
**/.cache/
**/.venv/
**/node_modules/
**/.DS_Store
**/.env
**/.env.*
**/credentials*
**/*secret*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.log
**/*.profraw
**/*.profdata
**/*.trace
**/*.gpr
**/*.rep/
**/*.dll
**/*.dylib
**/*.so
**/*.exe
**/*.ttf
**/*.otf
**/*.png
**/*.jpg
**/*.jpeg
**/*.pdf
**/*.md
