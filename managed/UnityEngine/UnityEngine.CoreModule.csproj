<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>UnityEngine.CoreModule</AssemblyName>
    <Version>0.1.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="PhysicsModule/**/*.cs" />
    <ProjectReference Include="../Scripting/UnityEngine.ScriptingModule.csproj" />
    <Compile Include="../Engine.Interop/OpenUnityNative.cs" Link="Interop/OpenUnityNative.cs" />
    <Compile Include="../Engine.Interop/OpenUnityNative.PhysicsMotion.cs" Link="Interop/OpenUnityNative.PhysicsMotion.cs" />
    <Compile Include="../Engine.Interop/OpenUnityNative.SceneSnapshot.cs" Link="Interop/OpenUnityNative.SceneSnapshot.cs" />
    <Compile Include="../Engine.Interop/OpenUnityNative.SceneRoots.cs" Link="Interop/OpenUnityNative.SceneRoots.cs" />
    <Compile Include="../Engine.Interop/OpenUnityNative.SceneValidity.cs" Link="Interop/OpenUnityNative.SceneValidity.cs" />
  </ItemGroup>
</Project>
